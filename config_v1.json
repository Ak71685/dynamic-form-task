{
  "formVersion": "v1",
  "fields": [
    {
      "id": "fullName",
      "label": "Full Name",
      "type": "text",
      "required": true,
      "minLength": 3
    },
    {
      "id": "email",
      "label": "Email",
      "type": "email",
      "required": true,
      "regex": "^[^@]+@[^@]+\\.[^@]+$"
    },
    {
      "id": "age",
      "label": "Age",
      "type": "number",
      "required": true,
      "min": 18,
      "max": 60
    },
    {
      "id": "isBusiness",
      "label": "Are you a business owner?",
      "type": "checkbox"
    },
    {
      "id": "gstNumber",
      "label": "GST Number",
      "type": "text"
    }
  ]
}
