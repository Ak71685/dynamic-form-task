{
  "version": 2,
  "title": "Lead Capture Form (v2)",
  "fields": [
    {
      "id": "fullName",
      "label": "Full Name",
      "type": "text",
      "required": true,
      "placeholder": "Enter your full name",
      "validation": {
        "minLength": 3
      }
    },
    {
      "id": "email",
      "label": "Email",
      "type": "text",
      "required": true,
      "placeholder": "name@company.com",
      "validation": {
        "regex": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      }
    },
    {
      "id": "phone",
      "label": "Phone Number",
      "type": "text",
      "required": false,
      "placeholder": "Optional (10 digits)",
      "validation": {
        "regex": "^[0-9]{10}$"
      }
    },
    {
      "id": "age",
      "label": "Age",
      "type": "number",
      "required": false,
      "placeholder": "Optional",
      "validation": {
        "min": 13,
        "max": 120
      }
    },
    {
      "id": "isBusiness",
      "label": "Business Account?",
      "type": "checkbox",
      "required": true
    },
    {
      "id": "gstNumber",
      "label": "GST Number",
      "type": "text",
      "required": true,
      "placeholder": "Enter GST Number",
      "visibleWhen": {
        "fieldId": "isBusiness",
        "equals": true
      },
      "validation": {
        "minLength": 10,
        "maxLength": 15
      }
    },
    {
      "id": "plan",
      "label": "Plan",
      "type": "select",
      "required": true,
      "options": [
        { "label": "Starter", "value": "starter" },
        { "label": "Growth", "value": "growth" },
        { "label": "Enterprise", "value": "enterprise" }
      ]
    }
  ]
}
